<?xml version="1.0" encoding="UTF-8"?><project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.6</version>
    <relativePath/>
  </parent>
  <groupId>com.buddy</groupId>
  <artifactId>travel-buddy-app</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>Travel Buddy Application</name>
  <description>Backend For My Dream Travel Buddy App</description>
  <properties>
    <java.version>17</java.version>
    <spring-cloud.version>2023.0.3</spring-cloud.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>1.18.30</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <modules>
    <module>lib/buddy-client</module>
    <!--Client's-->
    <module>microservices/buddy-profile-service/buddy-profile-client</module>
    <module>microservices/buddy-auth-service/buddy-auth-client</module>
    <module>microservices/buddy-post-service/buddy-post-client</module>
    <!--Services-->
    <module>microservices/buddy-discovery-service</module>
    <module>microservices/buddy-profile-service</module>
    <module>microservices/buddy-auth-service</module>
    <module>microservices/buddy-post-service</module>
    <module>microservices/buddy-post-service/buddy-post-client</module>
  </modules>
</project>
